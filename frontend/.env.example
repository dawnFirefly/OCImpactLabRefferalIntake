# Local Nuxt development only. Copy to ignored .env.local, then add a newly created key.
# Production: store NUXT_ANTHROPIC_API_KEY as a Cloudflare Worker Secret.
# Never put its value in tracked .env, wrangler.jsonc, public config, or build variables.
NUXT_ANTHROPIC_API_KEY=
# Pass 1: read the PDF, find forms/facts and highlight boxes. Pass 2: link facts to criteria.
NUXT_CLAUDE_EXTRACTION_MODEL=claude-haiku-5-5
NUXT_CLAUDE_REVIEW_MODEL=claude-sonnet-5-5

# Remote mutation access. Non-secret values; leave empty for localhost-only development.
NUXT_WORKSPACE_ORIGIN=
NUXT_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
NUXT_CLOUDFLARE_ACCESS_AUDIENCE=
NUXT_WORKSPACE_ALLOWED_EMAILS=
