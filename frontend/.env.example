# Copy to ignored .env.local. Never commit credentials.
# Default deployed provider uses the Cloudflare AI binding without an API key.
NUXT_AI_PROVIDER=cloudflare
# Optional local Workers AI REST credentials (or enter them in the homepage settings).
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_AI_TOKEN=
# Optional Anthropic server defaults; select Anthropic on the homepage.
NUXT_ANTHROPIC_API_KEY=
NUXT_CLAUDE_EXTRACTION_MODEL=claude-haiku-5-5
NUXT_CLAUDE_REVIEW_MODEL=claude-sonnet-5-5
# Optional OpenCode chat-compatible model defaults. Extraction must support images.
NUXT_OPENCODE_API_KEY=
NUXT_OPENCODE_EXTRACTION_MODEL=
NUXT_OPENCODE_REVIEW_MODEL=
# Remote access (leave empty for localhost-only development).
NUXT_WORKSPACE_ORIGIN=
NUXT_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
NUXT_CLOUDFLARE_ACCESS_AUDIENCE=
NUXT_WORKSPACE_ALLOWED_EMAILS=
NUXT_WORKSPACE_PUBLIC_ACCESS=false
